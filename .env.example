NEXT_PUBLIC_APP_URL=http://localhost:3000

# Browser-facing, domain-restricted map key (Sign up at https://cloud.maptiler.com)
NEXT_PUBLIC_MAPTILER_KEY=

# Map style identifier: streets-v2-dark, dataviz-dark, basic-v2-dark
NEXT_PUBLIC_MAPTILER_STYLE_ID=streets-v2-dark

# Server-side geographical search credential (MapTiler Geocoding API)
MAPTILER_GEOCODING_KEY=

# Server-side routing credential (Sign up at https://www.graphhopper.com)
GRAPHHOPPER_API_KEY=

# Provider profile mappings; verify actual account support
GRAPHHOPPER_PROFILE_CAR=car
GRAPHHOPPER_PROFILE_BIKE=bike
GRAPHHOPPER_PROFILE_FOOT=foot

# Supabase backend (Sign up at https://supabase.com)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only; optional and only for trusted administrative operations
SUPABASE_SERVICE_ROLE_KEY=
